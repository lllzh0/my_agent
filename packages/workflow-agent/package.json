		"@oh-my-pi/pi-tui": "workspace:*",
		"@oh-my-pi/pi-utils": "workspace:*",
		"@oh-my-pi/omptype": "workspace:*",
		"@anthropic-ai/sandbox-runtime": "0.0.50",
		"@mozilla/readability": "0.6.0",
		"linkedom": "0.18.12",
		"pdfjs-dist": "5.4.624",
		"diff": "catalog:"
	},
	"devDependencies": {
		"@types/shell-quote": "1.7.5",
		"@types/bun": "catalog:",
